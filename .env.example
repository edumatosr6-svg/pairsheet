# Configuração do site independente. Nunca publique o .env real.
APP_ORIGIN=http://localhost:3000
DATABASE_PATH=./data/simas.sqlite
PORT=3000
# Gere com: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SETUP_TOKEN=
# Para Vercel + Turso, configure estes valores na Vercel (não no repositório):
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Para Docker Compose com HTTPS:
DOMAIN=
